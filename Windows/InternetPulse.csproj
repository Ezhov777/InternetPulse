<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <Version>1.7.0</Version><AssemblyVersion>1.7.0.0</AssemblyVersion><FileVersion>1.7.0.8</FileVersion>
    <Product>Internet Pulse</Product><Company>Internet Pulse contributors</Company><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>../Assets/AppIcon.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><Content Include="../Resources/*.json" Link="Resources/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/><Content Include="../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
</Project>
